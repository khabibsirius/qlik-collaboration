{
  // NO "Urls" key here on purpose. appsettings.json is layered on top of host
  // configuration, so a "Urls" value here would OVERRIDE ASPNETCORE_URLS and the
  // app would bind to localhost inside a container or Windows Service — reachable
  // by nothing. The listen address comes from ASPNETCORE_URLS in production and
  // from Properties/launchSettings.json (dev only, never published) locally.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=qlik_collaboration;Username=postgres;Password=postgres"
  },
  "Storage": {
    "AttachmentsPath": ""
  },
  // Where the inbox's "open in Qlik" links point. Qlik Sense Desktop on this
  // machine; on a server set it to that server's hub, e.g. https://qlik.bank.local
  "Qlik": {
    "BaseUrl": "http://localhost:4848"
  },

  // The BI team: these usernames see every thread on a sheet. Everyone else — the
  // executives the dashboards are built for — sees only the threads they started, so
  // two of them never read each other's feedback. Use the Qlik identity, which is the
  // AD account name on Enterprise. LIST YOUR TEAM HERE: while this is empty everyone
  // is treated as a guest, and the API logs a warning at startup saying so.
  "Team": {
    "Members": []
  },

  // Digest e-mail to the BI team. Off until Enabled=true.
  //
  // To try it without a mail server, set PickupDirectory to a folder: the message is
  // written there as a .eml file you can open in Outlook, and nothing is sent. Clear
  // it and set Host to use the real relay.
  //
  // Send rule: whenever something new has been written, and at most once every
  // ReminderHours when there is nothing new but comments are still unanswered.
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 25,
    "UseStartTls": false,
    "User": "",
    "Password": "",
    "From": "qlik-collaboration@bank.local",
    "Recipients": [],
    "PickupDirectory": "",
    "InboxUrl": "http://localhost:5000/",
    "IntervalMinutes": 30,
    "ReminderHours": 24
  }
}
