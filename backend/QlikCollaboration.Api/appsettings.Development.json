{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Development only: logs every request line, so "did the panel even reach the
      // backend" can be answered from the log instead of guessed at.
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
    }
  },

  // Development only, never published. Qlik Sense Desktop has no login and reports
  // every user as "Personal\Me", so "Me" here means "whoever is testing on this
  // machine is on the team" — otherwise local testing shows an empty panel and looks
  // broken. On a server the real AD usernames go in appsettings.json instead.
  // Seeds roles into the database at startup; after that they are managed from the
  // team inbox. Admins is what stops a fresh install having nobody who can grant
  // anything. Seeding only ever raises a role, so panel changes survive a restart.
  "Team": {
    "Admins": [ "khabib" ],
    "Members": [ "Me" ]
  },

  // Local digest testing: writes the message to a folder as a .eml file instead of
  // sending it, so it can be opened in Outlook without a relay being configured.
  "Email": {
    "Enabled": true,
    "From": "qlik-collaboration@bank.local",
    "Recipients": [ "karimov@bank.local", "ivanov@bank.local" ],
    "PickupDirectory": "C:\\project\\qlikchatext\\mail-drop",
    "InboxUrl": "http://localhost:5000/",
    "IntervalMinutes": 30
  }
}
