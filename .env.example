# Copy to .env and edit. .env is git-ignored — never commit real credentials.

# --- database ---
POSTGRES_USER=qlik
# REQUIRED. Use a long random value; the stack refuses to start without it.
POSTGRES_PASSWORD=change-me-before-deploying

# --- API ---
# Host port the API listens on.
API_PORT=5000

# Origin of your Qlik Sense server, used for the CORS allowlist.
# Development: leave as * (any origin). Production: the exact Qlik host, e.g.
#   QLIK_ORIGIN=https://qlik.bank.local
QLIK_ORIGIN=*

# A comment with no @mention notifies the whole team. Set to false to limit
# notifications to @mentions and replies only.
BROADCAST_WHEN_NO_MENTION=true

# Swagger UI at /swagger. Turn off in production to reduce surface area.
SWAGGER_ENABLED=true
