# Copy to .env and edit. .env is git-ignored — never commit real credentials.

# ============================================================================
#  DATABASE
# ============================================================================
# Used by docker-compose.hostdb.yml / docker-compose.windows.yml, which connect
# to a PostgreSQL that is already installed on the server.
#
# host.docker.internal = the host machine as seen from inside the container.
# If that name does not resolve on your Docker engine, put the server's own LAN
# IP address here instead (e.g. 10.20.30.40) — never 127.0.0.1, which would mean
# the container itself.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=qlik_collaboration
DB_USER=postgres
# REQUIRED — the stack refuses to start without it.
DB_PASSWORD=change-me-before-deploying

# Only used by the all-in-one docker-compose.yml, which runs its OWN PostgreSQL
# container. Ignore these if the server already has PostgreSQL.
POSTGRES_USER=qlik
POSTGRES_PASSWORD=change-me-before-deploying

# ============================================================================
#  API
# ============================================================================
# Host port the API listens on. Must be open in the firewall for USER
# workstations — the extension runs in each user's browser, not on the server.
API_PORT=5000

# Origin of your Qlik Sense server, for the CORS allowlist. Production should be
# the exact host, e.g. https://qlik.bank.local  ( * allows any origin — dev only )
QLIK_ORIGIN=*

# Where the team inbox's "open the sheet" links point. This is a DIFFERENT setting
# from QLIK_ORIGIN above: that one decides which browser origin may call this API,
# this one is the address written into the links.
#
# Leave it empty and the inbox simply omits the links rather than sending people to
# the wrong machine. Set it to the hub your users actually open:
#   Enterprise : https://qlik.bank.local
#   Desktop    : http://localhost:4848
QLIK_BASE_URL=

# Swagger UI at /swagger. Keep false in production.
SWAGGER_ENABLED=false

# ============================================================================
#  WINDOWS CONTAINERS ONLY
# ============================================================================
# Must match the host Windows Server version or the container will not start.
#   Windows Server 2019 -> ltsc2019
#   Windows Server 2022 -> ltsc2022
#   Windows Server 2025 -> ltsc2025
# Check the host with:  (Get-ComputerInfo).OsName
WINDOWS_TAG=ltsc2022
